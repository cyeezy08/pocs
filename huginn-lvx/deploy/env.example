# huginn-lvx - /opt/huginn/.env template
# Fill in, then: sudo systemctl start huginn-pilot  (dry run lands in the journal)

# --- who to watch -----------------------------------------------------------
# Your GitHub username. fetch + draft + status work with ZERO X keys.
HUG_GH_USER=

# --- X keys (developer.x.com -> your app -> Keys and tokens) ----------------
# The original consumer key/secret pair was pasted into a Discord channel:
# REGENERATED keys only in this file. The access token pair comes from
# "OAuth 1.0a Access Token and Secret" -> Generate (app perms: Read and Write).
HUG_X_API_KEY=
HUG_X_API_SECRET=
HUG_X_ACCESS_TOKEN=
HUG_X_ACCESS_SECRET=

# --- autopilot switch ---------------------------------------------------------
# 0 = post step runs DRY RUN into the journal (watch it for a few days)
# 1 = post step actually sends. Flip only after you like what the dry runs show.
HUG_AUTOPILOT=0

# --- optional Telegram mirror of everything posted ---------------------------
HUG_TG_TOKEN=
HUG_TG_CHAT=

# --- state --------------------------------------------------------------------
HUG_STATE_DIR=/opt/huginn/state
