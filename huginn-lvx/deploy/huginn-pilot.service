[Unit]
Description=huginn-lvx GH->X pilot (fetch -> draft -> post)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=huginn
Group=huginn
EnvironmentFile=/opt/huginn/.env
ExecStart=/opt/huginn/pilot.sh
WorkingDirectory=/opt/huginn

[Install]
WantedBy=multi-user.target
