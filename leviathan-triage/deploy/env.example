# leviathan-feed - /opt/leviathan-feed/.env template
# Fill this in, then: sudo systemctl restart leviathan-feed-gateway

# --- lanes -----------------------------------------------------------------
# FREE lane webhook - the public #p0-digest channel (marketing, daily digest)
LT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/free
# PAID lane webhook - the private #p0-alerts channel, visible to the
# "Feed Subscriber" role only (P0/P1 realtime). Leave empty to run in
# single-lane trial mode (everything goes to the free webhook).
LT_DISCORD_WEBHOOK_PAID=

# --- checkout --------------------------------------------------------------
# Gumroad product permalink (the XXXX in gumroad.com/l/XXXX) - enables /subscribe
LT_GUMROAD_PERMALINK=
# Where the free-digest CTA points (your Gumroad product URL)
LT_BUY_URL=

# --- role gate -------------------------------------------------------------
# Guild id + role id for automatic role grant/revoke (Developer Mode → right click)
LT_DISCORD_GUILD_ID=
LT_DISCORD_ROLE_ID=

# --- bot -------------------------------------------------------------------
LT_DISCORD_BOT_TOKEN=
LT_DISCORD_APP_ID=

# --- Huginn: X/Twitter auto-poster (free-tier write-only, 1 post/day) ------
# developer.x.com app credentials. NEVER commit real keys - .env only.
# The consumer pair was pasted in Discord chat once: REGENERATE before go-live.
LT_X_CONSUMER_KEY=
LT_X_CONSUMER_SECRET=
# portal -> Keys and tokens -> generate OAuth 1.0a Access Token + Secret
LT_X_ACCESS_TOKEN=
LT_X_ACCESS_SECRET=
# Link appended to every post (your Discord invite - where the funnel lives)
LT_X_LINK=

# --- inventory (the stack the digest triages against) ----------------------
LT_ASSETS=/opt/leviathan-feed/assets.json
LT_STATE_DIR=/opt/leviathan-feed/state
