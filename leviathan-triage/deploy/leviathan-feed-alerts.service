[Unit]
Description=leviathan-feed realtime alerts (P0/P1 -> paid lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=leviathan
Group=leviathan
EnvironmentFile=/opt/leviathan-feed/.env
ExecStart=/opt/leviathan-feed/venv/bin/leviathan-triage daemon --once
WorkingDirectory=/opt/leviathan-feed

[Install]
WantedBy=multi-user.target
