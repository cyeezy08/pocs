[Unit]
Description=leviathan-feed free daily digest (marketing lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=leviathan
Group=leviathan
EnvironmentFile=/opt/leviathan-feed/.env
ExecStart=/opt/leviathan-feed/venv/bin/leviathan-triage digest
WorkingDirectory=/opt/leviathan-feed

[Install]
WantedBy=multi-user.target
