# Leviathan Intel - backend configuration
DB_NAME=leviathan
DB_USER=postgres
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5432

# Admin bearer token for the API (generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=

# Feeds
NVD_API_KEY=              # optional but strongly recommended (https://nvd.nist.gov/developers/request-an-api-key)
SHODAN_API_KEY=           # used ONLY for tenant-registered (authorized) assets

# Billing (beta): receive addresses, one per supported rail.
# Use wallets YOU control (self-custody, or your Telegram Wallet address).
# Customer picks the rail on their invoice; you confirm arrival, mark paid.
PAY_ADDRESS_TON=          # TON + USDT-TON (telegram-native, default rail)
PAY_ADDRESS_TRON=         # USDT-TRON (TRC-20, cheapest for SEA customers)
PAY_ADDRESS_SOL=          # USDT-SOL (SPL)
PAY_ADDRESS_BTC=          # Bitcoin on-chain
PAY_ADDRESS=              # legacy single-address fallback for TON family

# Wallet Pay (OPTIONAL auto-settle path). Store token from https://pay.wallet.tg/
# after KYB merchant approval. Unset = manual invoice flow only (default).
# Never commit this token; the webhook at POST /webhooks/wallet-pay verifies
# HMAC signatures keyed with it.
WALLET_PAY_TOKEN=
DISCORD_WEBHOOK_URL=         # channel webhook: Discord > channel settings > integrations; alerts disabled if unset
